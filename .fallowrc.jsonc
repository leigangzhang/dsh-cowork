{
  // tools/check-invariants.mjs already owns exports used only inside their own
  // module and keeps the reviewed ratchet; fallow must not report that class twice.
  "ignoreExportsUsedInFile": true,
  // The client bundle keeps react external (scripts/build/build-client.mjs) and
  // the DSH host supplies it at runtime; package.json intentionally declares no dependency.
  // Pele, Excalidraw, and the CodeMirror language packages are inlined into
  // lib/client.js at build time, so a production install never resolves them.
  "ignoreDependencies": ["react", "pele", "@excalidraw/excalidraw", "@codemirror/lang-html"],
  // Host-provided peer dependencies are not installed into the local node_modules.
  "ignoreUnresolvedImports": [
    "@deepseek-ai/cordis",
    "@deepseek-ai/dsh-atomic-write",
    "@deepseek-ai/dsh-host-webserver",
    "@deepseek-ai/dsh-tools",
    "@deepseek-ai/schemastery"
  ],
  // Fallow's built-in **/build/** ignore would hide scripts/build; the client
  // build script is first-party source and stays in scope.
  "ignorePatterns": ["!scripts/build/**"],
  // apply.ts:56 computes a repo-relative path with new URL(..., import.meta.url);
  // fallow treats it as a lazy module edge. architecture.test.mjs proves the
  // static import graph has no cycle.
  "circularDependencies": { "ignoreLazyImports": true },
  // An existing function that grows is still a change-level regression. Keep
  // the default audit gate from demoting it to a non-blocking warning.
  "audit": { "worsened": "error" }
}
