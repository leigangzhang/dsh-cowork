{
  "name": "@dsh-external/dsh-cowork",
  "version": "0.2.0",
  "description": "DSH 项目式主从协作插件：master 主会话 + 主题会话 + 项目记忆 + 工作项 + 评审请求 + 活动流",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.0-rc <2",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc <2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "node scripts/build-client.mjs",
    "typecheck": "bash scripts/build.sh --no-emit",
    "check": "node tools/check-invariants.mjs",
    "check:self-test": "node tools/check-invariants.mjs --self-test",
    "test": "node --test tests/*.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "external": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
