{
  "name": "@dsh-external/dsh-cowork",
  "version": "0.0.1",
  "description": "DSH 项目式主从协作插件：master 主会话 + 可对话 thread + 项目记忆 + worktree + handoff + review",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.0-rc <2",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc <2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "bash scripts/build.sh --no-emit",
    "check": "node tools/check-invariants.mjs",
    "check:self-test": "node tools/check-invariants.mjs --self-test",
    "test": "node --test tests/*.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  }
}
