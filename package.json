{
  "name": "@dsh-external/dsh-cowork",
  "version": "0.2.0",
  "description": "DSH 项目式主从协作插件：master 主会话 + 主题会话 + 项目记忆 + 工作项 + 评审请求 + 活动流",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.0-rc <2",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc <2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@types/node": "^24.13.3",
    "playwright": "1.65.1",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build/build.sh",
    "build:client": "node scripts/build/build-client.mjs",
    "typecheck": "bash scripts/build/build.sh --no-emit",
    "check": "node tools/check-invariants.mjs",
    "check:self-test": "node tools/check-invariants.mjs --self-test",
    "check:clean": "node scripts/evidence/clean-check.mjs",
    "change-scope": "node scripts/review/change-scope.mjs",
    "gate-artifact": "node scripts/review/gate-artifact.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:browser": "node scripts/evidence/browser-panel.mjs",
    "test:coverage": "node scripts/evidence/test-coverage.mjs",
    "test:coverage:layered": "node scripts/evidence/coverage-layered.mjs",
    "coverage:check": "node scripts/evidence/coverage-check.mjs",
    "test:host-smoke": "node scripts/evidence/host-smoke.mjs",
    "test:e2e": "node scripts/evidence/e2e.mjs",
    "test:e2e:live": "node scripts/evidence/e2e.mjs --mode live",
    "test:e2e:bash": "node scripts/evidence/e2e.mjs --mode bash"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "external": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
