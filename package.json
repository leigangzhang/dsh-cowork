{
  "name": "@dsh-external/dsh-cowork",
  "version": "0.2.0",
  "description": "DSH \u9879\u76ee\u5f0f\u4e3b\u4ece\u534f\u4f5c\u63d2\u4ef6\uff1amaster \u4e3b\u4f1a\u8bdd + \u4e3b\u9898\u4f1a\u8bdd + \u9879\u76ee\u8bb0\u5fc6 + \u5de5\u4f5c\u9879 + \u8bc4\u5ba1\u8bf7\u6c42 + \u6d3b\u52a8\u6d41",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0-rc <5",
    "@deepseek-ai/dsh-atomic-write": ">=0.2.0-rc <2",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc <2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc <2",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build/build.sh",
    "build:client": "node scripts/build/build-client.mjs",
    "typecheck": "bash scripts/build/build.sh --no-emit",
    "check": "node tools/check-invariants.mjs",
    "check:self-test": "node tools/check-invariants.mjs --self-test",
    "check:clean": "node scripts/evidence/clean-check.mjs",
    "change-scope": "node scripts/review/change-scope.mjs",
    "gate-artifact": "node scripts/review/gate-artifact.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "test:coverage": "node scripts/evidence/test-coverage.mjs",
    "test:host-smoke": "node scripts/evidence/host-smoke.mjs"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./client": {
      "default": "./lib/client.js"
    }
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "external": []
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
